{
  "name": "@dsh-local/side-chat",
  "version": "1.0.0",
  "description": "Right-sidebar side chat: a parallel, read-only conversation that explains the main conversation without interrupting it.",
  "license": "MIT",
  "author": "Lone-Jade",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lone-Jade/dsh-side-chat.git"
  },
  "homepage": "https://github.com/Lone-Jade/dsh-side-chat#readme",
  "bugs": {
    "url": "https://github.com/Lone-Jade/dsh-side-chat/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "side-chat",
    "sidebar",
    "read-only"
  ],
  "engines": {
    "dsh": ">=0.2.1 <0.3.0"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
